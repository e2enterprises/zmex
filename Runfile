elixir: # play a story using Elixir CLI
	cd exzm_cli
	mix exzm $(@)

rust: # play a story using Rust NIF
	cd encrusted_cli
	run start $(@)

test: # run exzm tests
	cd exzm
	mix test $(@)

build-elixir-release:
	cd exzm_cli
	MIX_ENV=prod mix release --overwrite

elixir-release:
	cd exzm_cli
	_build/prod/rel/exzm_cli/bin/exzm_cli eval ExzmCli.main $(@)
