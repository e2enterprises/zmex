install:
	mix deps.get

build: install # build zmex
	mix compile --force

clean: # remove dependencies and build files
	rm -rf _build deps priv
	rm native/encrusted_nif/encrusted-heart/tests/anchor.z8 # tmp file added by tests

docs: build # build docs site
	mix docs

read: docs # open the docs site after building
	open doc/index.html

test: build # run zmex tests
	mix test $(@)

build-elixir-release:
	cd zmex_cli
	MIX_ENV=prod mix release --overwrite

elixir-release:
	cd zmex_cli
	_build/prod/rel/zmex_cli/bin/zmex_cli eval ZmexCli.main $(@)

elixir: # play a story using Elixir CLI
	cd zmex_cli
	mix play $(@)

elixir-loop: # play a story using Elixir CLI
	cd zmex_cli
	mix loop $(@)

rust: # play a story using Rust NIF
	cd encrusted_cli
	RUST_BACKTRACE=1 cargo run -q -- ../native/encrusted_nif/encrusted-heart/tests/$(1) $(@:2)
