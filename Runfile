elixir: # play a story using Elixir CLI
	cd zmex_cli
	mix zmex $(@)

elixir-loop: # play a story using Elixir CLI
	cd zmex_cli
	mix loop $(@)

rust: # play a story using Rust NIF
	cd encrusted_cli
	run start $(@)

test: # run zmex tests
	cd zmex
	mix test $(@)

build-elixir-release:
	cd zmex_cli
	MIX_ENV=prod mix release --overwrite

elixir-release:
	cd zmex_cli
	_build/prod/rel/zmex_cli/bin/zmex_cli eval ZmexCli.main $(@)
